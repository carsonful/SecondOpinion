# Copy to backend/.env and adjust as needed. We can use the file to store private keys, database connection strings, credentials and other sensitive information. The .env is gitignored and therefore will not be publically available on repo.
# CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://secondopinion:secondopinion@localhost:5432/secondopinion
# NCBI requires a contact email for E-utilities usage.
# NCBI_EMAIL=your-real-contact-address@example.com
# Optional, for higher NCBI request limits.
# NCBI_API_KEY=

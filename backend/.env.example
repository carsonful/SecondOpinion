# Copy to backend/.env and adjust as needed. We can use the file to store private keys, database connection strings, credentials and other sensitive information. The .env is gitignored and therefore will not be publically available on repo.
# CORS_ORIGINS=["http://localhost:5173"]

# NCBI E-utilities (PubMed). Optional, but a key raises the limit from 3 to 10 requests/second.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ under "API Key Management".
# NCBI_API_KEY=
# NCBI_EMAIL=

# Azure Foundry: resource endpoint (or /openai/v1), deployed model name, resource key.
# The deployment must support Chat Completions with structured outputs.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_DEPLOYMENT=
AZURE_FOUNDRY_API_KEY=

# Full-text retrieval. Unpaywall finds open-access PDFs by DOI and requires a real
# contact email; falls back to NCBI_EMAIL when unset.
UNPAYWALL_EMAIL=

# Azure AI Document Intelligence parses those PDFs with the prebuilt layout model.
# Without both values, studies that only have a PDF fall back to their abstract.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# Optional tuning. Records are cached as JSON so repeated claims don't re-fetch.
# FULL_TEXT_CACHE_DIR=.cache/full_text
# FULL_TEXT_CONCURRENCY=4
# FULL_TEXT_STUDY_TIMEOUT=45
# STUDY_TOKEN_BUDGET=6000
